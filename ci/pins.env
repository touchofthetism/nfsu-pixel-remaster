# Every external input of the build, pinned. Sourced by ci/*.sh and the workflows.
# Change a pin here, nowhere else; the lift cache key includes this file.

# Sibling projects (CMake expects them next to this checkout: ../nfsu2-recompiled, ../pcrecomp).
NFSU2_REPO=https://github.com/codepdbh/nfsu2-recompiled
NFSU2_COMMIT=a8c7a39ce7b75b7a49368445a9a2b7ca5cf6e1f3
PCRECOMP_REPO=https://github.com/sp00nznet/pcrecomp
# The 14 patches in nfsu2-recompiled/patches/pcrecomp apply cleanly only at this commit.
PCRECOMP_COMMIT=35548b8d0fd8aa853da67edcf7cd6134f6b9cdc7
DXVK_REPO=https://github.com/Joshua-Ashton/dxvk-native
DXVK_COMMIT=c8dc91fabd00cac11d697ccf07426e798393cd40

# Android toolchain (android/app/build.gradle).
ANDROID_PLATFORM=android-35
ANDROID_BUILD_TOOLS=35.0.0
ANDROID_NDK=28.2.13676358
ANDROID_CMAKE=3.30.5
JAVA_VERSION=17
